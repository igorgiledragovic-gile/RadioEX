<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Legacy storage write for API <= 28 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- TV Home Screen Channels / Recommendations permissions -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- AppOps Attribution Tag for Audio Playback -->
    <attribution
        android:tag="radio_playback_attribution"
        android:label="@string/app_name" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <application
        android:name=".RadioEXApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner_radioex"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RadioWinamp"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Exclude default OkHttp Glide module to use our custom SSL-bypass module -->
        <meta-data
            android:name="com.bumptech.glide.integration.okhttp3.OkHttpLibraryGlideModule"
            tools:node="remove" />

        <!-- LauncherX TV Support Meta-data -->
        <meta-data
            android:name="com.google.android.tv.support.LEANBACK_LAUNCHER"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="radioex"
                    android:host="home" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="radioex"
                    android:host="play" />
            </intent-filter>
        </activity>

        <!-- Playback servis: MediaSessionCompat + MediaStyle notifikacija. -->
        <service
            android:name=".RadioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- MediaButtonReceiver: launcher očekuje registrovan media button
             receiver. Bez ovoga sistem ne može da restartuje playback iz
             Now Playing kartice. -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- TV Home Channels Initializer Receiver -->
        <receiver
            android:name=".tv.TvChannelReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.INITIALIZE_PROGRAMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Public ContentProvider to serve station posters and banners to Android TV LauncherX -->
        <provider
            android:name=".tv.TvPosterContentProvider"
            android:authorities="com.gilespii.radioex.tvposters"
            android:exported="true" />

    </application>

</manifest>
